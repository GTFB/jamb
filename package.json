{
  "name": "jamb",
  "version": "1.0.0",
  "description": "Jamb - Git-as-CMS platform with multi-site support",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd packages/config lint",
    "format": "bun run --cwd packages/config format",
    "test": "bun test",
    "type-check": "bun run --cwd apps/web type-check",
    "build:search-index": "bun run scripts/build-search-index.js",
    "optimize:images": "bun run scripts/optimize-images.js",
    "generate": "powershell -File scripts/generate.ps1",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "class-variance-authority": "^0.7.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "hygen": "^6.2.11",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.0"
  },
  "packageManager": "bun@1.0.0",
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@types/styled-components": "^5.1.34",
    "lucide-react": "^0.542.0",
    "react-hook-form": "^7.62.0",
    "sharp": "^0.34.3",
    "styled-components": "^6.1.19"
  }
}
